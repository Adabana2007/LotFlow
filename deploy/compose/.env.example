DB_USERNAME=root
DB_PASSWORD=1234
POSTGRES_HOST_PORT=5432
DB_POOL_MAX_SIZE=30
REDIS_USERNAME=root
REDIS_PASSWORD=1234
RABBITMQ_USERNAME=root
RABBITMQ_PASSWORD=1234
MILVUS_MINIO_ACCESS_KEY=root
MILVUS_MINIO_SECRET_KEY=root1234
MILVUS_MINIO_BUCKET=milvus-bucket
MILVUS_MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z
JWT_SECRET=replace-with-at-least-32-random-bytes
AI_VECTORSTORE_TYPE=none
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NICKNAME=LotFlow Admin

# AI secrets must stay in the untracked deploy/compose/.env file.
# Leave both keys empty and vectorstore=none until they are provided.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LOTFLOW_RERANK_URL=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_WRITE_REQUESTS=60
RATE_LIMIT_GENERAL_REQUESTS=180
RATE_LIMIT_REDIS_FAIL_OPEN=true
MAX_REQUEST_BYTES=1048576
WALLET_RECHARGE_ENABLED=false
REALTIME_ENABLED=true
